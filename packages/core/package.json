{
  "name": "@precisa-saude/fhir",
  "version": "0.21.0",
  "description": "Tipos FHIR R4, definições de biomarcadores, faixas de referência e conversores para o ecossistema de saúde brasileiro",
  "keywords": [
    "fhir",
    "r4",
    "brazil",
    "biomarker",
    "loinc",
    "sbpc-ml",
    "health"
  ],
  "homepage": "https://github.com/Precisa-Saude/fhir-brasil/tree/main/packages/core#readme",
  "bugs": "https://github.com/Precisa-Saude/fhir-brasil/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Precisa-Saude/fhir-brasil.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./biomarkers": {
      "import": {
        "types": "./dist/biomarkers.d.ts",
        "default": "./dist/biomarkers.js"
      },
      "require": {
        "types": "./dist/biomarkers.d.cts",
        "default": "./dist/biomarkers.cjs"
      }
    },
    "./reference-ranges": {
      "import": {
        "types": "./dist/reference-ranges.d.ts",
        "default": "./dist/reference-ranges.js"
      },
      "require": {
        "types": "./dist/reference-ranges.d.cts",
        "default": "./dist/reference-ranges.cjs"
      }
    },
    "./converter": {
      "import": {
        "types": "./dist/converter.d.ts",
        "default": "./dist/converter.js"
      },
      "require": {
        "types": "./dist/converter.d.cts",
        "default": "./dist/converter.cjs"
      }
    },
    "./importer": {
      "import": {
        "types": "./dist/importer.d.ts",
        "default": "./dist/importer.js"
      },
      "require": {
        "types": "./dist/importer.d.cts",
        "default": "./dist/importer.cjs"
      }
    },
    "./units": {
      "import": {
        "types": "./dist/units.d.ts",
        "default": "./dist/units.js"
      },
      "require": {
        "types": "./dist/units.d.cts",
        "default": "./dist/units.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./cli-utils": {
      "import": {
        "types": "./dist/cli-utils.d.ts",
        "default": "./dist/cli-utils.js"
      },
      "require": {
        "types": "./dist/cli-utils.d.cts",
        "default": "./dist/cli-utils.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fhir-bio": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src/ --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
